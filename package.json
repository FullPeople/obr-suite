{
  "name": "obr-suite",
  "version": "1.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node tools/build-legacy-card-viewer.mjs",
    "preview": "vite preview",
    "build:three-dragon": "tsc -p extensions/three-dragon-ante/tsconfig.json && vite build --config extensions/three-dragon-ante/vite.config.ts",
    "build:viewport-fx": "tsc -p extensions/viewport-fx/tsconfig.json && vite build --config extensions/viewport-fx/vite.config.ts",
    "build:workbench-dev": "node tools/build-workbench-dev.mjs",
    "test:workbench": "node tools/workbench-selftest.mjs",
    "build:card-viewer": "node tools/build-legacy-card-viewer.mjs"
  },
  "dependencies": {
    "@owlbear-rodeo/sdk": "^3.1.0",
    "preact": "^10.29.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  }
}
