+def _is_compiled_template_export(xlsx_path: Path, main_name: str, ej: dict) -> bool:
+    """Recognize our bounded Export-sheet compiler, not arbitrary AV1 overrides.
+
+    Some spreadsheet engines flatten referenced multiline constants in formula
+    results. Their source cells remain intact, so generated identity text must
+    not replace the already parsed cell text. Handwritten JSON and other
+    formulas keep their existing override behavior.
+    """
+    from openpyxl.formula.tokenizer import Tokenizer, TokenizerError
+
+    meta = ej.get("meta")
+    ruleset = meta.get("ruleset") if isinstance(meta, dict) else None
+    limits = {"5E2014": 863, "5E2024": 966}
+    if ej.get("schema") != "obr-suite-card/v1" or not isinstance(ruleset, str) or ruleset not in limits:
+        return False
+    last = limits[ruleset]
+    def quoted(value):
+        return '"' + value.replace('"', '""') + '"'
+    message = "ERROR: OBR_EXPORT_OUTPUT_TOO_LONG (maximum 32767 characters); no JSON exported."
+    prefix = '{"schema":"obr-suite-card/v1","meta":{"template":"'
+    suffix = '","ruleset":"' + ruleset + '"},"identity":{"character_name":"'
+    expected = (f'=IF(Export!A{last}>32767,{quoted(message)},'
+                f'{quoted(prefix)}&Export!A3&{quoted(suffix)}&Export!A{last-1})')
+
+    def tokens(formula):
+        result = []
+        for token in Tokenizer(formula).items:
+            if token.type == "WHITE-SPACE":
+                continue
+            value = token.value
+            if token.type == "OPERAND" and token.subtype == "RANGE":
+                # Excel/Calc differ in optional quoting and absolute markers.
+                match = re.fullmatch(r"(?:Export|'Export')!\$?A\$?(\d+)", value, re.I)
+                if match:
+                    value = "Export!A" + match.group(1)
+            elif token.type == "FUNC":
+                value = value.upper()
+            result.append((token.type, token.subtype, value))
+        return result
+
+    formulas = load_workbook(xlsx_path, data_only=False, read_only=True)
+    try:
+        cell = formulas[main_name]["AV1"]
+        if cell.data_type != "f" or not isinstance(cell.value, str):
+            return False
+        try:
+            return tokens(cell.value) == tokens(expected)
+        except (ValueError, IndexError, TokenizerError):
+            return False
+    finally:
+        formulas.close()
+
+
