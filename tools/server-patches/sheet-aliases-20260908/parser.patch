+def _sheet_name(wb, role: str, aliases: tuple[str, ...], *, required=False) -> str | None:
+    names = {name.casefold() for name in aliases}
+    found = [name for name in wb.sheetnames if name.casefold() in names]
+    if len(found) > 1:
+        raise ValueError(f"Ambiguous worksheet role {role}: {', '.join(found)}")
+    if not found and required:
+        raise ValueError(f"Missing required worksheet {role}: {' / '.join(aliases)}")
+    return found[0] if found else None
+
